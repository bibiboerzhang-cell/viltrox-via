{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "V-KPI Runner",
  "version": "0.1.0",
  "identifier": "com.viltrox.vkpi.runner",
  "build": {
    "frontendDist": "../"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "V-KPI 本地算力 Runner",
        "width": 760,
        "height": 620,
        "minWidth": 560,
        "minHeight": 460,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
