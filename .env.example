# V-KPI Local Development Environment
# 开发本地默认指向本地 stack,生产用 docker/k8s 的环境变量覆盖

# ─── Environment ──────────────────────────────
# local | staging | production
# 默认 local,生产环境必须显式覆盖
ENVIRONMENT=local

# ─── Database (defaults to LOCAL stack) ───────
# 默认指向本地 Postgres (54329/viltrox2)
# 生产环境用 docker-compose / k8s ConfigMap 覆盖 DATABASE_URL
DATABASE_URL=postgresql://postgres@127.0.0.1:54329/viltrox2

# Postgres connection pool (smoke 跑批量时建议设小)
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=8
POSTGRES_POOL_TIMEOUT_SEC=30

# ─── Redis ────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6380/0
# Redis 不可用时的进程内短暂兜底；三项上限共同防止参数化读缓存无限增长。
VKPI_MEMORY_CACHE_MAX_ENTRIES=2048
VKPI_MEMORY_CACHE_MAX_BYTES=67108864
VKPI_MEMORY_CACHE_MAX_ENTRY_BYTES=2097152

# ─── JWT ──────────────────────────────────────
# 本地开发请在 .env 中填写；生产必须通过 secret manager / deployment env 覆盖。
JWT_SECRET=
JWT_EXPIRES_DAYS=7
USER_CACHE_TTL_SEC=30

# ─── App ──────────────────────────────────────
APP_ROLE=admin-web
ADMIN_PASSWORD=
WEB_CONCURRENCY=2

# ─── Feature Flags (默认全 OFF,通过 settings UI 开启) ──
ENABLE_SCHEDULER=0
ENABLE_BROWSER=0
ENABLE_UPLOAD_CLEANUP=0

# Provider-free KOL contact L0 queue. Activate on the dedicated worker only
# after migration 282 and suppression HMAC configuration are present.
VKPI_CONTACT_ACQUISITION_L0_ENABLED=0
VKPI_CONTACT_ACQUISITION_BRAND_SCOPE=organization:1
VKPI_CONTACT_ACQUISITION_CADENCE_SECONDS=300
VKPI_CONTACT_ACQUISITION_BATCH_LIMIT=50
# Required before enabling L0: stable secret-manager value, at least 32 random
# bytes. Never commit the generated value; if stored locally, chmod the env
# file to 0600. Rotation requires a separately planned fingerprint migration.
VKPI_CONTACT_SUPPRESSION_HMAC_KEY=

# ─── External APIs (本地默认 empty,需要时填) ──
# YOUTUBE_API_KEY=
# CLAUDE_API_KEY=
# OPENAI_API_KEY=
# APIFY_TOKEN=

# ─── Cloudflare R2 media cache (optional) ─────
# Keep local unless R2 is fully configured. With hybrid/R2, newly cached V-KPI
# official-account videos are still written locally first, then uploaded to R2.
VKPI_MEDIA_CACHE_STORAGE=local
# VKPI_MEDIA_CACHE_STORAGE=hybrid
# VKPI_MEDIA_CACHE_R2_PREFIX=vkpi/media-cache
# VKPI_MEDIA_CACHE_R2_PUBLIC_BASE_URL=https://media.example.com
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=

# ─── DB Runtime Backend ───────────────────────
# postgres | sqlite (smoke 测试可能用 sqlite)
DB_RUNTIME_BACKEND=postgres

# ─── Observability / Monitoring ───────────────
# Sentry 错误上报:留空=关闭(本地默认关);生产在 deployment env / secret manager 覆盖。
# main.py 读到非空 SENTRY_DSN 才 sentry_sdk.init(traces_sample_rate=0.1)。
# SENTRY_DSN=
# 进程内请求指标(/api/admin/runtime/metrics)每 5 分钟由 scheduler 快照落 persistent_cache,
# 需 ENABLE_SCHEDULER=1 该后台任务才运行(重启后 requests_persisted 才有值)。
