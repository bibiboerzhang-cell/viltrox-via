APP_ROLE=public-web
ENVIRONMENT=production
ENV_FILE=
APP_STACK_NAME=viltrox-2.0-production
SITE_URL=http://127.0.0.1:8101
JWT_SECRET=
JWT_SECRET_PREVIOUS=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/viltrox2
DATABASE_POOL_URL=
DB_USE_PGBOUNCER=0
DB_RUNTIME_BACKEND=postgres
DB_TARGET_BACKEND=postgres
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_NAMESPACE=viltrox2:runtime
REDIS_JOB_STREAM_KEY=viltrox2:runtime:jobs:stream
REDIS_JOB_GROUP=viltrox2-workers
REDIS_JOB_DEAD_STREAM_KEY=viltrox2:runtime:jobs:dead
REDIS_JOB_EVENT_PREFIX=viltrox2:runtime:jobs:events
REDIS_CACHE_PREFIX=viltrox2:runtime:cache
REDIS_RATE_LIMIT_PREFIX=viltrox2:runtime:ratelimit
POSTGRES_POOL_MIN_SIZE=4
POSTGRES_POOL_MAX_SIZE=20
WORKER_ASYNC_CONSUMERS=15
VIDEO_WORKERS=30
RESPONSE_GZIP_MIN_SIZE=2048
ENABLE_LOCAL_ORCHESTRATOR=0
ENABLE_BROWSER=0
ENABLE_SCHEDULER=0
ENABLE_UPLOAD_CLEANUP=0
VITE_API_BASE=
APIFY_TOKEN=
APIFY_TOKEN_PREVIOUS=
RESEND_API_KEY=
RESEND_API_KEY_PREVIOUS=
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_VERIFY_TOKEN_PREVIOUS=
META_APP_SECRET=
META_APP_SECRET_PREVIOUS=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_WEBHOOK_SECRET_PREVIOUS=
TIKTOK_WEBHOOK_SECRET=
TIKTOK_WEBHOOK_SECRET_PREVIOUS=
