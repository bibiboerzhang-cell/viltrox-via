# V-KPI Local Development Environment
# 开发本地默认指向本地 stack,生产用 docker/k8s 的环境变量覆盖

# ─── Environment ──────────────────────────────
# local | staging | production
# 默认 local,生产环境必须显式覆盖
ENVIRONMENT=local

# ─── Database (defaults to LOCAL stack) ───────
# 默认指向本地 Postgres (54329/viltrox2)
# 生产环境用 docker-compose / k8s ConfigMap 覆盖 DATABASE_URL
DATABASE_URL=postgresql://postgres@127.0.0.1:54329/viltrox2

# Postgres connection pool (smoke 跑批量时建议设小)
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=8
POSTGRES_POOL_TIMEOUT_SEC=30

# ─── Redis ────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6380/0

# ─── JWT ──────────────────────────────────────
# 本地开发请在 .env 中填写；生产必须通过 secret manager / deployment env 覆盖。
JWT_SECRET=
JWT_EXPIRES_DAYS=7
USER_CACHE_TTL_SEC=30

# ─── App ──────────────────────────────────────
APP_ROLE=admin-web
ADMIN_PASSWORD=
WEB_CONCURRENCY=2

# ─── Feature Flags (默认全 OFF,通过 settings UI 开启) ──
ENABLE_SCHEDULER=0
ENABLE_BROWSER=0
ENABLE_UPLOAD_CLEANUP=0

# ─── External APIs (本地默认 empty,需要时填) ──
# YOUTUBE_API_KEY=
# CLAUDE_API_KEY=
# OPENAI_API_KEY=
# APIFY_TOKEN=

# ─── DB Runtime Backend ───────────────────────
# postgres | sqlite (smoke 测试可能用 sqlite)
DB_RUNTIME_BACKEND=postgres
