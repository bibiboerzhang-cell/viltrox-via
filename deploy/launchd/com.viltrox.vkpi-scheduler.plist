<?xml version="1.0" encoding="UTF-8"?>
<!-- 本地 scheduler 常驻服务模板。安装见同目录 README 或下方命令。
     RunAtLoad+KeepAlive:开机自启 + 崩溃自动重启。日志在 runtime/logs/。 -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.viltrox.vkpi-scheduler</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/bibiboer/Documents/V-KPI——marketing/scripts/run_scheduler_daemon.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/bibiboer/Documents/V-KPI——marketing</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>/Users/bibiboer/Documents/V-KPI——marketing/runtime/logs/scheduler.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/bibiboer/Documents/V-KPI——marketing/runtime/logs/scheduler.err.log</string>
</dict>
</plist>
