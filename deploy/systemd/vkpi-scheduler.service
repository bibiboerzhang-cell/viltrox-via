[Unit]
Description=V-KPI dedicated scheduler owner (A1 W1; leader lock keeps APScheduler single-owner)
Documentation=file:///opt/viltrox-2.0/current/deploy/systemd/README.md
Wants=network-online.target
After=network-online.target postgresql.service redis-server.service

[Service]
Type=simple
User=viltrox
Group=viltrox
UMask=0027
WorkingDirectory=/opt/viltrox-2.0/current
EnvironmentFile=/opt/viltrox-2.0/.env
# Optional numeric overrides only (pool sizes, budgets).  Never a secret store,
# and never the worker lane file: that one is a worker contract, not a web one.
EnvironmentFile=-/etc/vkpi/vkpi-scheduler-overrides.env
Environment=PYTHONPATH=/opt/viltrox-2.0/current/backend
Environment=PYTHONDONTWRITEBYTECODE=1
# start_scheduler.sh sources runtime_env.sh, which loads .env.production in
# override mode.  Refuse to start when that overlay could flip a fixed
# process-model value; the argv assignments below are the reviewed contract.
ExecStartPre=/bin/bash -c 'if [ -f /opt/viltrox-2.0/.env.production ] && grep -Eq "^[[:space:]]*(export[[:space:]]+)?(ENABLE_SCHEDULER|PORT|HOST|BIND|WORKERS|APP_ROLE)=" /opt/viltrox-2.0/.env.production; then echo "vkpi-scheduler: refusing start, .env.production overrides a fixed scheduler value" >&2; exit 1; fi'
# EnvironmentFile= values override Environment=, so the process-model contract
# travels as argv-level assignments exactly like the reviewed web/worker units.
# Direct PostgreSQL (DB_USE_PGBOUNCER=0): the leader election is a session
# level pg_try_advisory_lock and cannot cross a transaction-pooled connection.
# Port 8103 is the scheduler's loopback health listener; web stays on 8001.
ExecStart=/usr/bin/env APP_ROLE=worker ENVIRONMENT=production DB_RUNTIME_BACKEND=postgres LOCAL_RUNTIME_FORCE_STACK=0 RUNTIME_ENV_QUIET=1 ENABLE_SCHEDULER=1 ENABLE_LOCAL_ORCHESTRATOR=0 ENABLE_BROWSER=0 ENABLE_UPLOAD_CLEANUP=1 HOST=127.0.0.1 PORT=8103 WORKERS=1 DB_USE_PGBOUNCER=0 POSTGRES_POOL_MIN_SIZE=1 POSTGRES_POOL_MAX_SIZE=8 POSTGRES_POOL_TIMEOUT_SEC=30 PYTHON_BIN=/opt/viltrox-2.0/.venv/bin/python /bin/bash /opt/viltrox-2.0/current/scripts/start_scheduler.sh
Restart=always
RestartSec=5
TimeoutStopSec=60
KillMode=mixed
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vkpi-scheduler
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/opt/viltrox-2.0/current
ReadOnlyPaths=/opt/viltrox-2.0/.env
ReadOnlyPaths=-/opt/viltrox-2.0/.env.production
ReadWritePaths=/opt/viltrox-2.0/uploads
ReadWritePaths=/opt/viltrox-2.0/runtime
ReadWritePaths=/opt/viltrox-2.0/frames
ReadWritePaths=/opt/viltrox-2.0/creator_profiles
ReadOnlyPaths=-/opt/viltrox-2.0/.release-controller
InaccessiblePaths=/opt/viltrox-2.0/backups

[Install]
WantedBy=multi-user.target
