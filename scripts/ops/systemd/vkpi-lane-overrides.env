# 车道运行参数覆盖(安装到 /etc/vkpi/vkpi-lane-overrides.env)。
# systemd 里 EnvironmentFile 后读者胜:此文件排在 /opt/viltrox-2.0/.env 之后,专门压过 .env 旧值。
# 零密钥文件——密钥永远只住 .env。
# ⚠ 部署漂移警告(2026-07-22):deploy_local_to_cloud.sh 每次部署都用本模板整文件覆盖
#   /etc/vkpi/vkpi-lane-overrides.env 并 cmp 校验。prod 线上文件若手调过(QPS/并发),
#   部署前必须先把线上值收编回本模板,否则会被静默打回。
APIFY_WORKER_GEMINI_QPS=1.0
APIFY_WORKER_LLM_CONCURRENCY=16
# 满功率档(2026-07-22 收编,用户令「云端满功率」):16 车道编制下资源槽为
# DB 全局信号量,代码侧上限 MAX_RESOURCE_SLOT_CAP=16;视频 16 / 媒体 8 / 评论 8
# 与 Gemini Tier 2(3000 RPM / 3M TPM)余量核对过。调小只需改此模板重部署。
APIFY_WORKER_PROFILE_MEDIA_CONCURRENCY=8
APIFY_WORKER_COMMENTS_CONCURRENCY=8
APIFY_WORKER_GEMINI_VIDEO_CONCURRENCY=16
LLM_MONTHLY_BUDGET_USD=3000
POSTGRES_POOL_MIN_SIZE=2
# 连接预算(2026-07-22 多并发地基):PG max_connections=200(prod 实测)。
# 旧值 16 → 16 条车道最坏 16×16=256,单这一项就超 PG 上限。车道 worker 是单进程串行,
# 库内并行读扇出上限 4(market_brain/parallel_reads.py MAX_PARALLEL_READ_WORKERS),
# 6 = 主连接 + 4 并行读 + 1 余量,worker 语义零损。
# 新最坏账:车道 16×6=96 + redis worker 16 + web 2×16=32 + 租约/运维~14 ≈ 158 < 200。
POSTGRES_POOL_MAX_SIZE=6
# worker 永远直连 5432,绝不走 PgBouncer——apify 车道用 session 级 advisory lock
# (Gemini QPS 闸 pg_advisory_lock / LLM slot),transaction pooling 下 session 锁会
# 漂到别的 server 连接 = 闸失效。此行显式压过 .env 未来可能出现的 DATABASE_POOL_URL
# 自动开关(config.py:193 有 DATABASE_POOL_URL 时 DB_USE_PGBOUNCER 缺省=1)。
DB_USE_PGBOUNCER=0
