# 车道运行参数覆盖(安装到 /etc/vkpi/vkpi-lane-overrides.env)。
# systemd 里 EnvironmentFile 后读者胜:此文件排在 /opt/viltrox-2.0/.env 之后,专门压过 .env 旧值。
# 零密钥文件——密钥永远只住 .env。
APIFY_WORKER_GEMINI_QPS=0.25
APIFY_WORKER_LLM_CONCURRENCY=4
# Provider-family slots default to the current serial-safe shape.  Promote all
# three to 2 only for the reviewed two-lane staging canary; code rejects >2.
APIFY_WORKER_PROFILE_MEDIA_CONCURRENCY=1
APIFY_WORKER_COMMENTS_CONCURRENCY=1
APIFY_WORKER_GEMINI_VIDEO_CONCURRENCY=1
LLM_MONTHLY_BUDGET_USD=3000
POSTGRES_POOL_MIN_SIZE=2
POSTGRES_POOL_MAX_SIZE=16
