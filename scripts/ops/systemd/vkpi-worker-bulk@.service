[Unit]
Description=V-KPI apify_jobs worker - bulk lane %i (claims all tiers)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/viltrox-2.0
EnvironmentFile=/opt/viltrox-2.0/.env
Environment=PYTHONPATH=/opt/viltrox-2.0/backend
Environment=APIFY_WORKER_CLAIM_LANE=all
Environment=APIFY_WORKER_HEARTBEAT_NAME=apify-worker-bulk-%i
Environment=APIFY_WORKER_GEMINI_QPS=0.25
Environment=APIFY_WORKER_LLM_CONCURRENCY=4
Environment=LLM_MONTHLY_BUDGET_USD=3000
Environment=POSTGRES_POOL_MIN_SIZE=2
Environment=POSTGRES_POOL_MAX_SIZE=16
ExecStart=/opt/viltrox-2.0/.venv/bin/python -m app.workers.apify_jobs_worker
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=1300
NoNewPrivileges=true
PrivateTmp=false

[Install]
WantedBy=multi-user.target
