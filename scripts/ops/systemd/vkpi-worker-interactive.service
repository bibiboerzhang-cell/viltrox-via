[Unit]
Description=V-KPI apify_jobs worker - interactive lane (claims only tier-0 jobs)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/viltrox-2.0
EnvironmentFile=/opt/viltrox-2.0/.env
EnvironmentFile=-/etc/vkpi/vkpi-lane-overrides.env
Environment=PYTHONPATH=/opt/viltrox-2.0/backend
Environment=APIFY_WORKER_CLAIM_LANE=interactive
Environment=APIFY_WORKER_HEARTBEAT_NAME=apify-worker-interactive
ExecStart=/opt/viltrox-2.0/.venv/bin/python -m app.workers.apify_jobs_worker
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=1300
NoNewPrivileges=true
PrivateTmp=false

[Install]
WantedBy=multi-user.target
