{
  "name": "viltrox-marketing-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:cross-board-catalog": "node scripts/generate-cross-board-module-catalog.mjs",
    "check:i18n": "node scripts/check-i18n-contract.mjs",
    "build": "node scripts/generate-cross-board-module-catalog.mjs --check && tsc --noEmit && vite build --configLoader runner",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "framer-motion": "^12.40.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.16.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-grid-layout": "^2.2.3",
    "react-router": "7.18.3",
    "react-router-dom": "7.18.3",
    "three": "^0.184.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-geo": "^3.1.0",
    "@types/leaflet": "^1.9.21",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.5.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.5.4",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
