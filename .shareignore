# Defense-in-depth exclusions for scripts/package_share.sh.
# The script first builds a Git-tracked allowlist and applies equivalent
# path-only hard guards before rsync sees any source file.

# Version control, dependency trees, toolchains, and caches
.git/
**/.git/
.venv/
**/.venv/
venv/
**/venv/
node_modules/
**/node_modules/
__pycache__/
**/__pycache__/
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/
.tox/
**/.tox/
.nox/
**/.nox/
.cache/
**/.cache/
frontend/dist/

# Secrets and environment files (including examples and backups)
.env
.env.*
**/.env
**/.env.*
id_rsa
id_dsa
id_ecdsa
id_ed25519
.netrc
.npmrc
.pypirc
credentials.json
client_secret.json
service-account.json
service_account.json
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
*.jks
*.keystore

# Databases, backup bundles, and nested archives
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.dump
*.pgdump
*.backup
*.bak
*.tar
*.tgz
*.tar.gz
*.zip
*.7z
backups/
**/backups/
backup/
**/backup/
snapshots/
**/snapshots/

# Runtime, user data, generated reports, and other large output trees
runtime/
reports/
artifacts/
exports/
output/
outputs/
tmp/
uploads/
frames/
creator_profiles/
.share-stage/
viltrox-2.0-share.tar.gz
viltrox-2.0-share.tar.gz.sha256
viltrox-2.0-share.tar.gz.files.txt

# Host metadata
.DS_Store
**/.DS_Store
