{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://v-kpi.local/schemas/gemini-final-v1-quality-gold-v1.json",
  "title": "Gemini final_v1 offline quality gold set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "dataset_kind",
    "claim_status",
    "timestamp_tolerance_seconds",
    "metric_thresholds",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "gemini_final_v1_quality_gold_v1"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "dataset_kind": {
      "enum": ["synthetic", "human_adjudicated_media"]
    },
    "claim_status": {
      "const": "descriptive_only"
    },
    "timestamp_tolerance_seconds": {
      "type": "number",
      "minimum": 0
    },
    "metric_thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brand_accuracy_min",
        "unknown_as_absent_max",
        "non_title_evidence_recall_min",
        "product_precision_min",
        "product_recall_min",
        "competitor_f1_min",
        "evidence_modality_support_min",
        "evidence_timestamp_support_min",
        "unsupported_absent_max",
        "schema_coverage_min"
      ],
      "properties": {
        "brand_accuracy_min": {"type": "number", "minimum": 0, "maximum": 1},
        "unknown_as_absent_max": {"type": "integer", "minimum": 0},
        "non_title_evidence_recall_min": {"type": "number", "minimum": 0, "maximum": 1},
        "product_precision_min": {"type": "number", "minimum": 0, "maximum": 1},
        "product_recall_min": {"type": "number", "minimum": 0, "maximum": 1},
        "competitor_f1_min": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_modality_support_min": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_timestamp_support_min": {"type": "number", "minimum": 0, "maximum": 1},
        "unsupported_absent_max": {"type": "integer", "minimum": 0},
        "schema_coverage_min": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "aliases"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "sku": {"type": "string"},
        "brand": {"type": "string"},
        "aliases": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "entity_type",
        "entity_key",
        "modality",
        "timestamp_seconds",
        "in_title",
        "observation"
      ],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "entity_type": {"enum": ["brand", "product", "competitor"]},
        "entity_key": {"type": "string", "minLength": 1},
        "modality": {"enum": ["visual", "subtitle", "audio"]},
        "timestamp_seconds": {"type": "number", "minimum": 0},
        "in_title": {"const": false},
        "observation": {"type": "string", "minLength": 1}
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brand_status",
        "inspection_complete",
        "checked_modalities",
        "products",
        "competitors",
        "evidence"
      ],
      "properties": {
        "brand_status": {"enum": ["present", "absent", "unknown"]},
        "inspection_complete": {"type": "boolean"},
        "checked_modalities": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["visual", "subtitle", "audio"]}
        },
        "products": {
          "type": "array",
          "items": {"$ref": "#/$defs/entity"}
        },
        "competitors": {
          "type": "array",
          "items": {"$ref": "#/$defs/entity"}
        },
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence"}
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "media_sha256",
        "model",
        "prompt_version",
        "title_context_only",
        "expected"
      ],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "media_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "model": {"type": "string", "minLength": 1},
        "prompt_version": {"type": "string", "minLength": 1},
        "title_context_only": {
          "type": "string",
          "description": "Context only. Evaluators must never treat this field as evidence."
        },
        "expected": {"$ref": "#/$defs/expected"}
      }
    }
  }
}
